
#######################
###  COLOR SCHEME   ###
#######################

include ~/.cache/wal/colors-sway


#######################
###     BAR         ###
#######################

bar {
    # Position & Appearance
    position            bottom
    height              32
    workspace_min_width 32
    separator_symbol  " "
    font              Iosevka Nerd Font Medium 14
    
    # Status Command
    status_command    i3status-rs ~/.config/sway/i3st-rs.toml

    # Colors
    colors {
        background          $background
        statusline          $foreground
        separator           $foreground
        
        # Workspace colors
        focused_workspace   $foreground  $foreground  $background
        active_workspace    $background  $background  $foreground
        inactive_workspace  $background  $background  $foreground
        urgent_workspace    $background  $background  $color3
    }
}


#######################
###  WINDOW STYLE   ###
#######################

# Layout
workspace_layout tabbed

# Cursor
seat seat0 xcursor_theme Bibata-Modern-Ice

# Borders
font                      Iosevka Nerd Font 12
default_border            pixel 2
default_floating_border   pixel 2
hide_edge_borders         smart
titlebar_padding          8 1 

# Client Colors
client.focused           $foreground   $foreground   $background   $foreground   $foreground
client.focused_inactive  $background   $background   $foreground   $background   $background
client.unfocused         $background   $background   $foreground   $background   $background
client.urgent            $foreground   $foreground   $background   $foreground   $foreground
client.placeholder       $background   $background   $foreground   $background   $background

# SwayFX Features

# Blur Effects
blur on
blur_xray off
blur_passes 4
blur_radius 5

# Background
output * bg $wallpaper fill


#######################
###  AUTOSTART      ###
#######################

exec          brightnessctl s 20%
exec_always   pipewire
exec_always   dbus-run-session udiskie 
exec_always   emacs --daemon
exec_always   kdeconnectd
exec_always   mako --ignore-timeout 0 --default-timeout 3000
exec_always   mpd
exec_always   wlsunset -S 7:00 -s 19:00


#######################
###  KEY BINDINGS   ###
#######################

# Variables
set $mod     Mod4
set $left    h
set $down    j
set $up      k
set $right   l

set $term    alacritty
set $browser librewolf
set $menu    bemenu-run \
    --fn "Iosevka Nerd Font Medium 13" \
    --fb "$background" \
    --ff "$foreground" \
    --nb "$background" \
    --nf "$foreground" \
    --tb "$background" \
    --hb "$background" \
    --tf "$foreground" \
    --hf "$color3" \
    --af "$foreground" \
    --ab "$background" \
    --line-height 32 \
    --prompt "" \
    --list 3 down \
    --ch 20 \
    --bottom \
    -n

# Application Shortcuts
bindsym {
    $mod+q              exec $term
    $mod+Return		exec emacsclient -c
    $mod+r 		exec $menu
    $mod+Tab            exec gtklock
    $mod+Shift+d      	kill
}

# Window Management
bindsym {
    $mod+Shift+space  floating toggle
    $mod+Ctrl+r       reload
    $mod+Shift+Ctrl+q exec swaymsg exit
}

# Focus Navigation
bindsym {
    $mod+$left        focus left
    $mod+$down        focus down
    $mod+$up          focus up
    $mod+$right       focus right
    
    $mod+Left         focus left
    $mod+Down         focus down
    $mod+Up           focus up
    $mod+Right        focus right
    
    $mod+Space        focus mode_toggle
    $mod+A            focus parent
}

# Window Movement
bindsym {
    $mod+Shift+$left  move left
    $mod+Shift+$down  move down
    $mod+Shift+$up    move up
    $mod+Shift+$right move right
    
    $mod+Shift+Left   move left
    $mod+Shift+Down   move down
    $mod+Shift+Up     move up
    $mod+Shift+Right  move right
}

# Workspaces
bindsym {
    # Switch workspace
    $mod+1            workspace number 1
    $mod+2            workspace number 2
    $mod+3            workspace number 3
    $mod+4            workspace number 4
    $mod+5            workspace number 5
    $mod+6            workspace number 6
    $mod+7            workspace number 7
    $mod+8            workspace number 8
    $mod+9            workspace number 9
    $mod+0            workspace number 10
    
    # Move to workspace
    $mod+Shift+1      move container to workspace number 1
    $mod+Shift+2      move container to workspace number 2
    $mod+Shift+3      move container to workspace number 3
    $mod+Shift+4      move container to workspace number 4
    $mod+Shift+5      move container to workspace number 5
    $mod+Shift+6      move container to workspace number 6
    $mod+Shift+7      move container to workspace number 7
    $mod+Shift+8      move container to workspace number 8
    $mod+Shift+9      move container to workspace number 9
    $mod+Shift+0      move container to workspace number 10
}

# Layout Operations
bindsym {
    $mod+v            split
    $mod+Ctrl+e       layout toggle split
    $mod+f            fullscreen
    $mod+Shift+s      move scratchpad
    $mod+s            scratchpad show
}

# Controls
bindsym {
    XF86AudioMute          exec wpctl set-mute @DEFAULT_SINK@ toggle
    XF86AudioLowerVolume   exec wpctl set-volume @DEFAULT_SINK@ 0.05-
    XF86AudioRaiseVolume   exec wpctl set-volume @DEFAULT_SINK@ 0.05+
    XF86AudioPlay          exec playerctl play-pause -a
    XF86AudioPause         exec playerctl play-pause -a
    XF86AudioNext	   exec playerctl next -a
    XF86AudioPrev	   exec playerctl previous -a
    XF86MonBrightnessDown  exec brightnessctl s 5%-
    XF86MonBrightnessUp    exec brightnessctl s +5%
}

# Screenshots
bindsym Print exec grimshot copy area


#######################
###    GESTURES     ###
#######################

bindgesture {
    swipe:left   workspace next
    swipe:right  workspace prev
}


#######################
###  INPUT CONFIG   ###
#######################

input "type:keyboard" {
    xkb_layout   us,ru
    xkb_options  grp:rctrl_toggle,caps:ctrl_modifier
}

input "type:touchpad" {
    tap             enabled
    # disable while typing
    dwt             disable
    natural_scroll  enabled
    accel_profile   "adaptive"
    pointer_accel   0.24
}


#######################
###  RESIZE MODE    ###
#######################

mode "resize" {
    bindsym {
        $left   resize shrink width 8px
        $down   resize grow height 8px
        $up     resize shrink height 8px
        $right  resize grow width 8px
        
        Left    resize shrink width 8px
        Down    resize grow height 8px
        Up      resize shrink height 8px
        Right   resize grow width 8px
        
        Return  mode "default"
        Escape  mode "default"
    }
}
bindsym $mod+Shift+r mode "resize"

####################
###  RUN MODE    ###
####################

mode "run" {
    bindsym {
	b    exec $browser
	k    exec kdeconnect-app
	p    exec prismlauncher
	l    exec localsend

	Return  mode "default"
        Escape  mode "default"
    }
}
bindsym $mod+Shift+a mode "run"
